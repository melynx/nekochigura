From: nekochigura maintainers
Subject: [PATCH] Contain Rust panics inside the PAM entry point

Never allow a Rust panic to cross the C PAM ABI. Convert it into a closed
authentication failure instead.

Rebased onto v0.2.12: upstream added a `flags: c_int` parameter to the
do_authenticate() helper, so the call inside the catch_unwind closure now
threads it through. Nothing else changed; upstream still has no panic
containment of its own at this entry point (v0.2.12 uses catch_unwind in
gaze-core/src/dbus.rs and gaze/src/daemon.rs, but not here).
diff --git a/pam-gaze/src/lib.rs b/pam-gaze/src/lib.rs
index 6df8e87..c923a73 100644
--- a/pam-gaze/src/lib.rs
+++ b/pam-gaze/src/lib.rs
@@ -5,6 +5,7 @@
 use gaze_core::dbus::GazeProxy;
 use pam_gaze_core::*;
 use std::os::raw::{c_char, c_int};
+use std::panic::{AssertUnwindSafe, catch_unwind};
 use std::time::Duration;
 use tokio::time::timeout;
 
@@ -227,7 +228,10 @@ pub unsafe extern "C" fn pam_sm_authenticate(
     _argc: c_int,
     _argv: *const *const c_char,
 ) -> c_int {
-    unsafe { do_authenticate(pamh, flags) }
+    match catch_unwind(AssertUnwindSafe(|| unsafe { do_authenticate(pamh, flags) })) {
+        Ok(code) => code,
+        Err(_) => PAM_AUTH_ERR,
+    }
 }
 
 pam_gaze_core::pam_success_stubs!();
