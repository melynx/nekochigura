index 076e7118..9e9e0634 100644
--- a/modules/lock/center/PasswordInput.qml
+++ b/modules/lock/center/PasswordInput.qml
@@ -66,7 +66,7 @@ StyledRect {
             AnimLoader {
                 anchors.centerIn: parent
