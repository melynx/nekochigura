     }
 }
+#endif
 
 /**
  * nv_drm_atomic_crtc_duplicate_state - crtc state duplicate hook
@@ -2265,7 +2312,11 @@ static void nv_drm_atomic_crtc_destroy_state(struct drm_crtc *crtc,
 static struct drm_crtc_funcs nv_crtc_funcs = {
