         kfree(nv_plane_state);
     }
 }
+#endif
 
 
 static struct drm_plane_state *
@@ -2056,7 +2078,11 @@ static const struct drm_plane_funcs nv_plane_funcs = {
     .update_plane           = drm_atomic_helper_update_plane,
